<resources>
    <!-- =================================================================== -->
    <!-- DYNAMIC KEYBOARD LANGUAGE & LAYOUT REGISTRY                         -->
    <!-- To add a new language or layout, simply:                           -->
    <!-- 1. Add your layout ID to 'registered_keyboard_layouts' array below -->
    <!-- 2. Define layout_<id>_lang_code, lang_name, layout_name            -->
    <!-- 3. Define row1, row2, row3 (and optional shifted rows)              -->
    <!-- The app will automatically register and adapt without touching Kotlin! -->
    <!-- =================================================================== -->

    <string-array name="registered_keyboard_layouts">
        <item>en_qwerty</item>
        <item>bn_jatiya</item>
        <item>bn_avro</item>
        <item>hi_devanagari</item>
    </string-array>

